+// proxyHost and proxyPort split a proxy address for Firefox's preferences,
+// which name the host and the port apart. An address with no port gets the
+// default of its scheme.
+func proxyHost(address string) string {
+	u, err := url.Parse(address)
+	if err != nil {
+		return address
+	}
+	return u.Hostname()
+}
+
+func proxyPort(address string) int {
+	u, err := url.Parse(address)
+	if err != nil {
+		return 8080
+	}
+	if port, err := strconv.Atoi(u.Port()); err == nil {
+		return port
+	}
+	switch u.Scheme {
+	case "https":
+		return 443
+	case "socks5", "socks5h":
+		return 1080
+	default:
+		return 8080
+	}
+}
+
 // cookieDatabaseModTime is the later modification time of a Firefox profile's
 // cookie database and its write-ahead log. The zero time means the profile has
 // neither yet.
