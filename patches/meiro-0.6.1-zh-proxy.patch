 	// everything else does, 1 or 0 for their own pace.
 	PodcastSpeed float64 `json:"podcastSpeed,omitempty"`
 	MusicSpeed   float64 `json:"musicSpeed,omitempty"`
+	// Proxy is the proxy Meiro sends its traffic through, empty for a direct
+	// connection. It takes the forms a browser shows, such as
+	// "http://127.0.0.1:7890" or "socks5://127.0.0.1:1080".
+	Proxy string `json:"proxy,omitempty"`
+	// Language is the language of the interface: LanguageAuto follows the
+	// system, otherwise LanguageEnglish or LanguageChinese.
+	Language string `json:"language,omitempty"`
+}
+
+// The languages the interface offers.
+const (
+	// LanguageAuto follows the language of the system.
+	LanguageAuto = "auto"
+	// LanguageEnglish shows the interface in English.
+	LanguageEnglish = "en"
+	// LanguageChinese shows the interface in Simplified Chinese.
+	LanguageChinese = "zh"
+)
+
+// LanguageOrDefault reads the zero value of a settings file written before the
+// interface had a language as LanguageAuto.
+func LanguageOrDefault(language string) string {
+	switch language {
+	case LanguageEnglish, LanguageChinese:
+		return language
+	default:
+		return LanguageAuto
+	}
 }
 
