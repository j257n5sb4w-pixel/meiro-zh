+package lang
+
+// words is every interface string that is shown whole, in English, and what it
+// says in Simplified Chinese. A string not listed shows in English.
+var words = map[string]string{
+	// Sign-in
+	"Sign in to YouTube Music":      "登录 YouTube Music",
+	"Sign in":                       "登录",
+	"Sign out":                      "退出登录",
+	"Signed in":                     "已登录",
+	"Not signed in":                 "未登录",
+	"Sign in with a browser window": "使用浏览器窗口登录",
+	"Advanced":                      "高级",
+	"Cookie header":                 "Cookie 请求头",
+	"Paste the Cookie header":       "粘贴 Cookie 请求头",
+	"Import from a browser":         "从浏览器导入",
